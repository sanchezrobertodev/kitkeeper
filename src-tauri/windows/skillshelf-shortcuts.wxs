<?xml version="1.0" encoding="utf-8"?>
<!--
  Skillshelf was renamed Kitkeeper in 0.6.0. The Skillshelf MSI skips RemoveShortcuts while an upgrade removes it (tauri
  does that to keep same-named shortcuts), so after the upgrade to Kitkeeper its shortcuts stay behind under the old name,
  pointing at a deleted exe. This deletes them, and the folders they keep alive.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!-- Only while this install replaces a Skillshelf MSI: every version before 0.6.0 was called Skillshelf. -->
    <Upgrade Id="303d0147-1c3b-583e-9da6-5ae00b9e3282">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes" Maximum="0.6.0" IncludeMaximum="no" OnlyDetect="yes" Property="SKILLSHELFFOUND" />
    </Upgrade>

    <!-- AppSearch runs before the upgrade removes Skillshelf and this value with it. -->
    <Property Id="SKILLSHELFDIR" Secure="yes">
      <RegistrySearch Id="SkillshelfInstallDir" Root="HKCU" Key="Software\sanchezroberto\Skillshelf" Name="InstallDir" Type="raw" />
    </Property>
    <!-- Only the user who installed Skillshelf has that value; for anyone else, try the default folder. -->
    <SetProperty Id="SKILLSHELFDIR" Value="[ProgramFiles64Folder]Skillshelf\" After="AppSearch" Sequence="both">NOT SKILLSHELFDIR</SetProperty>

    <DirectoryRef Id="ProgramMenuFolder">
      <Directory Id="SkillshelfProgramsFolder" Name="Skillshelf" />
    </DirectoryRef>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="RemoveSkillshelfShortcuts" Guid="*">
        <Condition>SKILLSHELFFOUND</Condition>
        <RemoveFile Id="SkillshelfStartMenuShortcut" Directory="SkillshelfProgramsFolder" Name="Skillshelf.lnk" On="install" />
        <RemoveFolder Id="SkillshelfStartMenuFolder" Directory="SkillshelfProgramsFolder" On="install" />
        <RemoveFile Id="SkillshelfDesktopShortcut" Directory="DesktopFolder" Name="Skillshelf.lnk" On="install" />
        <RemoveFile Id="SkillshelfUninstallShortcut" Property="SKILLSHELFDIR" Name="Uninstall Skillshelf.lnk" On="install" />
        <RemoveFolder Id="SkillshelfInstallFolder" Property="SKILLSHELFDIR" On="install" />
        <RegistryValue Root="HKCU" Key="Software\sanchezroberto\Kitkeeper" Name="Skillshelf Shortcuts Removed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
