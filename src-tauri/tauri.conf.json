{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kitkeeper",
  "version": "0.8.0",
  "identifier": "dev.sanchezroberto.skillshelf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kitkeeper",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Claude Code skills & plugins manager",
    "longDescription": "Browse, filter and update the skills and plugins installed for Claude Code.",
    "category": "DeveloperTool",
    "windows": {
      "nsis": { "installerHooks": "./windows/hooks.nsh" },
      "wix": {
        "upgradeCode": "303d0147-1c3b-583e-9da6-5ae00b9e3282",
        "fragmentPaths": ["./windows/skillshelf-shortcuts.wxs"],
        "componentRefs": ["RemoveSkillshelfShortcuts"]
      }
    },
    "linux": {
      "deb": { "conflicts": ["skillshelf"], "replaces": ["skillshelf"] },
      "rpm": { "obsoletes": ["skillshelf"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwNjgwQjdCODczOUQyNkYKUldSdjBqbUhld3Rvd055Z0h1ZUhNMTU0ai9oU0lBUDZZVExOUGlMM3FJU3BwcU9YM2RMMlF5UHUK",
      "endpoints": ["https://github.com/sanchezrobertodev/kitkeeper/releases/latest/download/latest.json"]
    }
  }
}
